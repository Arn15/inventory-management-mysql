# Copy to .env and change every value. .env is gitignored.

# Admin account: used only by `python src/manage.py ...` (schema setup, user admin).
# With Docker Compose this is also the MySQL root password.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=change-me-admin

# Least-privilege accounts the app connects with (created by `manage.py init-db`)
DB_AUTH_PASSWORD=change-me-auth
DB_MANUFACTURER_PASSWORD=change-me-manufacturer
DB_SUPPLIER_PASSWORD=change-me-supplier
DB_VIEWER_PASSWORD=change-me-viewer

# Optional: give every seeded app user this password (demo only). If empty, init-db
# generates a random password per user and prints them once.
DEMO_USER_PASSWORD=

# Optional overrides of config/config.yaml
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_ACCOUNT_HOST=%
